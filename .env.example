# Скопируйте в .env и при необходимости измените значения.
POSTGRES_PASSWORD=postgres
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=24h
# Демонстрационные данные (пользователи, рестораны, меню)
DEMO_SEED=true
# Эмуляция платёжного провайдера
PAYMENT_DELAY=1500ms
PAYMENT_MAX_AMOUNT=1000000
LOG_LEVEL=info
# Порт веб-клиента и REST API на хосте
GATEWAY_PORT=8080
